{
  "name": "voyager-sidebar",
  "displayName": "Voyager — Cross-Agent Continuity",
  "description": "Browse WorkThreads and agent sessions indexed by voyager, compose and preview continuation bundles with token estimates, view a WorkThread's timeline across every agent that touched it, and switch a thread to another agent.",
  "version": "0.1.0",
  "publisher": "HarryHeYu",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:voyager.overview",
    "onCommand:voyager.openComposer",
    "onCommand:voyager.openTimeline",
    "onView:voyager.threads"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "voyager.overview",
        "title": "Voyager: Show Overview"
      },
      {
        "command": "voyager.bundlePreview",
        "title": "Voyager: Preview Continuation Bundle"
      },
      {
        "command": "voyager.openComposer",
        "title": "Voyager: Open Context Composer"
      },
      {
        "command": "voyager.openTimeline",
        "title": "Voyager: Open WorkThread Timeline"
      },
      {
        "command": "voyager.switchThread",
        "title": "Voyager: Switch WorkThread to another agent",
        "enablement": "viewItem == thread"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "voyager.openTimeline",
          "when": "view == voyager.threads",
          "group": "navigation"
        },
        {
          "command": "voyager.openComposer",
          "when": "view == voyager.threads",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "voyager.switchThread",
          "when": "view == voyager.threads && viewItem == thread",
          "group": "inline@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "voyager",
          "title": "Voyager",
          "icon": "media/voyager.svg"
        }
      ]
    },
    "views": {
      "voyager": [
        {
          "id": "voyager.threads",
          "name": "WorkThreads"
        }
      ]
    },
    "configuration": {
      "title": "Voyager",
      "properties": {
        "voyager.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python interpreter that has voyager installed."
        },
        "voyager.repoPath": {
          "type": "string",
          "default": "",
          "description": "Workspace path used to resolve the active WorkThread."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package"
  }
}
